generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum PackageStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  VODAFONE_CASH
  CARD
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  DONE
  MISSED
}

enum CompanyType {
  TRAVEL_AGENCY
  CORPORATE
  HOTEL
  PARTNER
  OTHER
}

enum CompanyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ActivityAction {
  CLIENT_CREATED
  LEAD_CREATED
  LEAD_EDITED
  LEAD_DELETED
  LEAD_CONVERTED
  BOOKING_CREATED
  BOOKING_EDITED
  BOOKING_CANCELLED
  PAYMENT_ADDED
  PROFILE_LOGGED_IN
  DATA_EXPORTED
  TASK_COMPLETED
  TASK_CREATED
  PACKAGE_CREATED
  FILE_UPLOADED
  PROFILE_CREATED
  PROFILE_PASSWORD_RESET
  DATA_IMPORTED
  COMPANY_CREATED
  COMPANY_UPDATED
  COMPANY_ARCHIVED
  SETTINGS_UPDATED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profiles  Profile[]
  otpTokens OtpToken[]
  sessions  Session[]

  @@index([email])
}

model Session {
  id                String    @id @default(cuid())
  token             String    @unique
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlockedProfileId String?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([token])
  @@index([userId])
}

model Profile {
  id             String        @id @default(cuid())
  name           String
  passwordHash   String
  isAdmin        Boolean       @default(false)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  leads          Lead[]
  bookings       Booking[]
  tasks          Task[]
  payments       Payment[]
  activityLogs   ActivityLog[]
  resetTokens    ProfilePasswordResetToken[]
  clients        Client[]
  uploadedFiles  UploadedFile[]
  companies      Company[]
  appSettings    AppSetting[]

  @@unique([name])
  @@index([name])
  @@index([isAdmin])
}

model AppSetting {
  id                 String   @id @default(cuid())
  key                String   @unique
  value              Json
  category           String
  isSecret           Boolean  @default(false)
  updatedByProfileId String?
  updatedByProfile   Profile? @relation(fields: [updatedByProfileId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([category])
  @@index([updatedByProfileId])
}

model ProfilePasswordResetToken {
  id           String    @id @default(cuid())
  profileId    String
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  email        String
  tokenHash    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  createdAt    DateTime  @default(now())

  @@index([profileId, email, createdAt])
}

model OtpToken {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  requestIp    String?
  createdAt    DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
}

model Company {
  id                String        @id @default(cuid())
  name              String
  type              CompanyType   @default(TRAVEL_AGENCY)
  status            CompanyStatus @default(ACTIVE)
  contactPerson     String?
  phone             String?
  email             String?
  address           String?
  taxId             String?
  commissionPercent Decimal?      @db.Decimal(5, 2)
  notes             String?
  assignedProfileId String?
  assignedProfile   Profile?      @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  clients           Client[]
  bookings          Booking[]
  activityLogs      ActivityLog[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([name])
  @@index([type])
  @@index([status])
  @@index([assignedProfileId])
}

model Lead {
  id                 String      @id @default(cuid())
  clientName         String
  phone              String
  email              String?
  source             LeadSource
  interestedPackage  String
  interestedDestination String?
  budget             Decimal?    @db.Decimal(12, 2)
  travelDate         DateTime?
  travelers          Int
  travelersCount     Int?
  status             LeadStatus  @default(NEW)
  notes              String?
  assignedProfileId  String?
  assignedProfile    Profile?    @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  convertedClientId  String?
  convertedBookingId String?
  booking            Booking?
  tasks              Task[]
  activityLogs       ActivityLog[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([status])
  @@index([source])
  @@index([assignedProfileId])
  @@index([createdAt])
}

model Client {
  id             String     @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  nationality    String?
  passportNumber String?
  companyId      String?
  company        Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes          String?
  assignedProfileId String?
  assignedProfile   Profile?   @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  leads          Lead[]
  bookings       Booking[]
  tasks          Task[]
  activityLogs   ActivityLog[]
  uploadedFiles  UploadedFile[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([phone])
  @@index([email])
  @@index([assignedProfileId])
  @@index([companyId])
  @@index([createdAt])
}

model Package {
  id               String        @id @default(cuid())
  name             String
  destination      String
  duration         String
  price            Decimal       @db.Decimal(12, 2)
  description      String
  includedServices String
  excludedServices String
  availableDates   DateTime[]
  capacity         Int
  status           PackageStatus @default(ACTIVE)
  bookings         Booking[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([status])
  @@index([destination])
}

model Booking {
  id                String         @id @default(cuid())
  bookingCode       String         @unique
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId         String?
  package           Package?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  packageNameSnapshot String?
  leadId            String?        @unique
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  travelDate        DateTime
  travelers         Int
  totalPrice        Decimal        @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus     PaymentStatus  @default(UNPAID)
  bookingStatus     BookingStatus  @default(PENDING)
  assignedProfileId String?
  assignedProfile   Profile?       @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  companyId         String?
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  notes             String?
  payments          Payment[]
  tasks             Task[]
  activityLogs      ActivityLog[]
  uploadedFiles     UploadedFile[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([bookingStatus])
  @@index([paymentStatus])
  @@index([assignedProfileId])
  @@index([companyId])
  @@index([travelDate])
  @@index([createdAt])
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientId         String?
  clientName       String
  amountPaid       Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentDate      DateTime
  notes            String?
  recordedById     String?
  recordedBy       Profile?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  activityLogs     ActivityLog[]
  createdAt        DateTime      @default(now())

  @@index([recordedById])
  @@index([paymentDate])
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  dueAt             DateTime
  dueDate           DateTime?
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(PENDING)
  assignedProfileId String?
  assignedProfile   Profile?     @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activityLogs      ActivityLog[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([dueAt])
  @@index([dueDate])
  @@index([status])
  @@index([assignedProfileId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  message   String
  metadata  Json?
  profileId String?
  profile   Profile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  companyId String?
  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paymentId String?
  payment   Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())

  @@index([profileId])
  @@index([companyId])
  @@index([message])
  @@index([createdAt])
}

model UploadedFile {
  id                  String    @id @default(cuid())
  fileName            String
  fileUrl             String
  fileType            String
  fileSize            Int
  relatedBookingId    String?
  relatedBooking      Booking?  @relation(fields: [relatedBookingId], references: [id], onDelete: SetNull)
  relatedClientId     String?
  relatedClient       Client?   @relation(fields: [relatedClientId], references: [id], onDelete: SetNull)
  uploadedByProfileId String?
  uploadedByProfile   Profile?  @relation(fields: [uploadedByProfileId], references: [id], onDelete: SetNull)
  createdAt           DateTime  @default(now())

  @@index([relatedBookingId])
  @@index([relatedClientId])
  @@index([uploadedByProfileId])
  @@index([createdAt])
}
