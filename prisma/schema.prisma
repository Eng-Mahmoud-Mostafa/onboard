generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum LeadSource {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  WEBSITE
  REFERRAL
  WALK_IN
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  FOLLOW_UP
  CONVERTED
  LOST
}

enum PackageStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  INSTAPAY
  VODAFONE_CASH
  CARD
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  DONE
  MISSED
}

enum ActivityAction {
  CLIENT_CREATED
  LEAD_CREATED
  LEAD_EDITED
  LEAD_CONVERTED
  BOOKING_CREATED
  PAYMENT_ADDED
  PROFILE_LOGGED_IN
  DATA_EXPORTED
  TASK_COMPLETED
  PROFILE_CREATED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  profiles  Profile[]
  otpTokens OtpToken[]
}

model Profile {
  id             String        @id @default(cuid())
  name           String
  passwordHash   String
  isAdmin        Boolean       @default(false)
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  leads          Lead[]
  bookings       Booking[]
  tasks          Task[]
  payments       Payment[]
  activityLogs   ActivityLog[]

  @@unique([name])
}

model OtpToken {
  id           String    @id @default(cuid())
  email        String
  tokenHash    String
  expiresAt    DateTime
  consumedAt   DateTime?
  attemptCount Int       @default(0)
  requestIp    String?
  createdAt    DateTime  @default(now())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
}

model Lead {
  id                 String      @id @default(cuid())
  clientName         String
  phone              String
  email              String?
  source             LeadSource
  interestedPackage  String
  budget             Decimal?    @db.Decimal(12, 2)
  travelDate         DateTime?
  travelers          Int
  status             LeadStatus  @default(NEW)
  notes              String?
  assignedProfileId  String?
  assignedProfile    Profile?    @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  clientId           String?
  client             Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  booking            Booking?
  tasks              Task[]
  activityLogs       ActivityLog[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
}

model Client {
  id             String     @id @default(cuid())
  fullName       String
  phone          String
  email          String?
  nationality    String?
  passportNumber String?
  notes          String?
  leads          Lead[]
  bookings       Booking[]
  tasks          Task[]
  activityLogs   ActivityLog[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Package {
  id               String        @id @default(cuid())
  name             String
  destination      String
  duration         String
  price            Decimal       @db.Decimal(12, 2)
  description      String
  includedServices String
  excludedServices String
  availableDates   DateTime[]
  capacity         Int
  status           PackageStatus @default(ACTIVE)
  bookings         Booking[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Booking {
  id                String         @id @default(cuid())
  bookingCode       String         @unique
  clientId          String
  client            Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  packageId         String
  package           Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  leadId            String?        @unique
  lead              Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  travelDate        DateTime
  travelers         Int
  totalPrice        Decimal        @db.Decimal(12, 2)
  paidAmount        Decimal        @default(0) @db.Decimal(12, 2)
  remainingAmount   Decimal        @default(0) @db.Decimal(12, 2)
  paymentStatus     PaymentStatus  @default(UNPAID)
  bookingStatus     BookingStatus  @default(PENDING)
  assignedProfileId String?
  assignedProfile   Profile?       @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  notes             String?
  payments          Payment[]
  tasks             Task[]
  activityLogs      ActivityLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model Payment {
  id               String        @id @default(cuid())
  bookingId        String
  booking          Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  clientName       String
  amountPaid       Decimal       @db.Decimal(12, 2)
  paymentMethod    PaymentMethod
  paymentDate      DateTime
  notes            String?
  recordedById     String?
  recordedBy       Profile?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  activityLogs     ActivityLog[]
  createdAt        DateTime      @default(now())
}

model Task {
  id                String       @id @default(cuid())
  title             String
  description       String?
  dueAt             DateTime
  priority          TaskPriority @default(MEDIUM)
  status            TaskStatus   @default(PENDING)
  assignedProfileId String?
  assignedProfile   Profile?     @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  leadId            String?
  lead              Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  clientId          String?
  client            Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  bookingId         String?
  booking           Booking?     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  activityLogs      ActivityLog[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model ActivityLog {
  id        String         @id @default(cuid())
  action    ActivityAction
  message   String
  metadata  Json?
  profileId String?
  profile   Profile?       @relation(fields: [profileId], references: [id], onDelete: SetNull)
  leadId    String?
  lead      Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientId  String?
  client    Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking?       @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  paymentId String?
  payment   Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  taskId    String?
  task      Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt DateTime       @default(now())
}
